#!/usr/bin/env bash
# Hara v1.9 pre-push hook
# Enforces: if a release/ship-style commit is being pushed, recent codex
# review evidence must exist. This catches the v0.5/v0.6 pattern of
# "shipped without 2-round codex review" — the harness *requires* it but
# nothing enforced it.
#
# Trigger: any push that includes a commit with subject matching
# `^(code|harness|note)\(.*v\d+\.\d+\.\d+\)` (the conventional ship form).
#
# Bypass: `git push --no-verify` (Claude must NOT use this without user OK).

set -u

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Read the refs being pushed via stdin (git pre-push protocol).
# `note(...)` is the metadata-only ship type — it announces a ship that
# happened in a gitignored sub-project (e.g., `examples/starpin/`). The
# actual code + reviews live outside this repo's tracked tree, so HC-11
# evidence cannot be discovered via `git log`. Only `code(...)` and
# `harness(...)` ship types are subject to the in-repo review evidence
# check. This carveout was discovered during starpin v0.7 dogfood — the
# hook would otherwise block legitimate metadata-only `note()` ships.
ship_pattern='^(code|harness)\([^)]*v[0-9]+\.[0-9]+\.[0-9]+\)'
ship_subjects=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "$local_sha" ]] && continue
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    # New branch — review all commits in it.
    range="$local_sha"
  else
    range="${remote_sha}..${local_sha}"
  fi
  while read -r subject; do
    if [[ "$subject" =~ $ship_pattern ]]; then
      ship_subjects+="$subject"$'\n'
    fi
  done < <(git log --pretty=%s "$range" 2>/dev/null)
done

if [[ -z "$ship_subjects" ]]; then
  exit 0   # no ship-style commit; pass
fi

echo "[pre-push] ship-style commits detected:" >&2
echo "$ship_subjects" | sed 's/^/    /' >&2

# r1 #1 — HC-11 requires r1+r2 for THIS ship slug, not "any recent review".
# Extract version slug (the captured part: e.g. starpin-v0.6.0, v1.8).
# We accept either:
#   (a) explicit version like v0.6.0, vN.N.N anywhere in subject
#   (b) the parenthesized scope token, lower-cased
# Then require BOTH a file matching `*r1*.md` AND `*r2*.md` whose name contains
# at least one of those slugs, added in last 30 commits.
# Collect candidate slugs from ship-style commit subjects.
# Portable to macOS bash 3.2 (no mapfile, no arrays-of-quoted-strings).
ship_slugs_raw=""
while IFS= read -r subj; do
  [[ -z "$subj" ]] && continue
  # Parenthesized scope: code(STARPIN-v0.6.0) → starpin-v0.6.0
  paren="${subj#*\(}"; paren="${paren%%\)*}"
  if [[ -n "$paren" ]]; then
    slug_full="$(echo "$paren" | tr '[:upper:]' '[:lower:]')"
    ship_slugs_raw+="$slug_full"$'\n'
    # Compressed: starpin-v0.6.0 → starpin-v060, v1.8.0 → v180, v0.6 → v06
    slug_compact="$(echo "$slug_full" | sed -E 's/v([0-9]+)\.([0-9]+)\.?([0-9]*)/v\1\2\3/g')"
    [[ "$slug_compact" != "$slug_full" ]] && ship_slugs_raw+="$slug_compact"$'\n'
    # Two-digit major.minor compressed (drop patch): v1.8.0 → v18, v0.6.x → v06
    slug_short="$(echo "$slug_full" | sed -E 's/v([0-9]+)\.([0-9]+)\.[0-9]+/v\1\2/g; s/v([0-9]+)\.([0-9]+)/v\1\2/g')"
    [[ "$slug_short" != "$slug_full" && "$slug_short" != "$slug_compact" ]] && ship_slugs_raw+="$slug_short"$'\n'
  fi
done <<< "$ship_subjects"

ship_slugs="$(echo "$ship_slugs_raw" | grep -v '^$' | sort -u)"

# Collect review files added in last 30 commits (covers patch round + ship).
recent_review_files="$(git log -30 --diff-filter=A --name-only --pretty=format: -- '*.harness/reviews/*.md' 2>/dev/null | grep -v '^$' | sort -u)"
if [[ -z "$recent_review_files" ]]; then
  echo "[pre-push] FAIL: ship commit but 0 codex review files in last 30 commits." >&2
  echo "[pre-push]   HC-11 requires r1 + r2 reviews for every ship." >&2
  echo "[pre-push]   Run: scripts/codex-bundle-review.sh --phase 04 --prompt-file <prompt>" >&2
  exit 1
fi

# r2 #1 partial close — track r1/r2 *per primary slug* (the parenthesized
# scope from each ship subject). If ANY ship in the push lacks r1+r2 for its
# own slug, fail. Compressed slug variants are still tried but the BOOK is
# kept per primary so multi-ship pushes are detected.
fail_count=0
missing_summary=""
# Re-extract primary (parenthesized) slug per ship subject.
while IFS= read -r subj; do
  [[ -z "$subj" ]] && continue
  paren="${subj#*\(}"; paren="${paren%%\)*}"
  [[ -z "$paren" ]] && continue
  primary="$(echo "$paren" | tr '[:upper:]' '[:lower:]')"
  # Generate same compressed variants as before, but scoped to THIS primary.
  variants="$primary"$'\n'
  variants+="$(echo "$primary" | sed -E 's/v([0-9]+)\.([0-9]+)\.?([0-9]*)/v\1\2\3/g')"$'\n'
  variants+="$(echo "$primary" | sed -E 's/v([0-9]+)\.([0-9]+)\.[0-9]+/v\1\2/g; s/v([0-9]+)\.([0-9]+)/v\1\2/g')"$'\n'
  variants="$(echo "$variants" | grep -v '^$' | sort -u)"

  has_r1=0; has_r2=0
  while IFS= read -r variant; do
    [[ -z "$variant" ]] && continue
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      fname_lc="$(echo "$(basename "$f")" | tr '[:upper:]' '[:lower:]')"
      if [[ "$fname_lc" == *"$variant"* ]]; then
        [[ "$fname_lc" == *r1* ]] && has_r1=1
        [[ "$fname_lc" == *r2* ]] && has_r2=1
      fi
    done <<< "$recent_review_files"
  done <<< "$variants"

  if [[ $has_r1 -ne 1 || $has_r2 -ne 1 ]]; then
    fail_count=$((fail_count+1))
    missing_summary+="  - $subj: r1=$has_r1 r2=$has_r2 (slug='$primary')"$'\n'
  fi
done <<< "$ship_subjects"

if [[ $fail_count -gt 0 ]]; then
  echo "[pre-push] FAIL: HC-11 cadence not met for $fail_count ship-style commit(s)." >&2
  echo "$missing_summary" >&2
  echo "[pre-push]   Each ship needs r1 + r2 review file names containing its slug." >&2
  echo "[pre-push]   Bypass: git push --no-verify (requires explicit user authorization)." >&2
  exit 1
fi

# --- HC-12: User-Flow-Verified -----------------------------------------------
# UI surface detection: a repo has UI when any tracked path matches `public/`
# at depth 1 (e.g., `backend/public/`, `frontend/public/`). For dogfood
# projects in `examples/` (gitignored from this repo), the smoke evidence
# lives in the gitignored tree — `note(...)` ship-style was already exempted
# above. For in-repo UI projects, ship requires recent passing smoke evidence
# in `.harness/runs/e2e-*.json` (last 24h, status=pass).
has_ui_surface=0
while IFS= read -r path; do
  case "$path" in
    public|*/public|public/*|*/public/*) has_ui_surface=1; break;;
    frontend|*/frontend|frontend/*|*/frontend/*) has_ui_surface=1; break;;
  esac
done < <(git ls-tree -r --name-only HEAD 2>/dev/null)

if [[ $has_ui_surface -eq 1 ]]; then
  # Find recent passing smoke evidence.
  runs_dir="$REPO_ROOT/.harness/runs"
  if [[ ! -d "$runs_dir" ]]; then
    echo "[pre-push] FAIL: HC-12 — UI surface present but no $runs_dir/ directory." >&2
    echo "[pre-push]   Run UI smoke: ./scripts/run-e2e-smoke.sh (or equivalent)" >&2
    exit 1
  fi
  # r1 #2: tight evidence validation (not just mtime + grep). Parse JSON,
  # require status=pass + exit_code=0 + test_count>=1 + ran_at within 24h
  # (clock-skew-resistant). Hardens against accidentally-passing JSON files
  # or hand-written forgeries.
  recent_pass=""
  for f in "$runs_dir"/e2e-*.json; do
    [[ -f "$f" ]] || continue
    if python3 - "$f" <<'PYEOF' 2>/dev/null
import sys, json, datetime
try:
    d = json.load(open(sys.argv[1]))
    if d.get('status') != 'pass': sys.exit(1)
    if int(d.get('exit_code', -1)) != 0: sys.exit(1)
    if int(d.get('test_count', 0)) < 1: sys.exit(1)
    ran_at = d.get('ran_at', '')
    if not ran_at: sys.exit(1)
    ts = datetime.datetime.strptime(ran_at.replace('Z', '+00:00').replace('+0000', '+00:00'),
                                    '%Y-%m-%dT%H:%M:%S%z')
    age_sec = (datetime.datetime.now(datetime.timezone.utc) - ts).total_seconds()
    if age_sec > 86400 or age_sec < -300:  # -5min slack for clock skew
        sys.exit(1)
    sys.exit(0)
except Exception:
    sys.exit(1)
PYEOF
    then
      recent_pass="$f"
      break
    fi
  done
  if [[ -z "$recent_pass" ]]; then
    echo "[pre-push] FAIL: HC-12 — UI surface detected but no valid passing e2e-*.json in last 24h." >&2
    echo "[pre-push]   Evidence must have: status=pass, exit_code=0, test_count>=1, ran_at within 24h." >&2
    echo "[pre-push]   Run: ./scripts/run-e2e-smoke.sh   (or your project's equivalent)" >&2
    echo "[pre-push]   Then re-push. Bypass: git push --no-verify (explicit user authorization)." >&2
    exit 1
  fi
  echo "[pre-push] OK — HC-12 UI smoke evidence: $(basename "$recent_pass")" >&2
fi

echo "[pre-push] OK — HC-11 r1+r2 evidence found for every ship in push" >&2
exit 0
